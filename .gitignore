# ---------------------------------------------------------------------------
# Runtime data (see src/soccermaster/paths.py). SOCCERMASTER_HOME defaults to the
# repo root in an editable install, so this is where the package writes.
# ---------------------------------------------------------------------------
/data/
/weights/
/outputs/

# scratch root the example notebook uses outside Colab/Kaggle
/soccermaster_home/

# Modal app: videos go up, exported data comes back
/videos/
/modal-outputs/
.modal/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# build artefacts
build/
dist/
*.egg
*.egg-info/

# generated by setuptools-scm at build time
/src/soccermaster/_version.py

# virtualenvs
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Model weights and large binaries. The pipeline downloads these into weights/
# (ignored above); these rules also catch a stray copy dropped anywhere else.
# ---------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.tar
*.pklz

# Deformable attention compiled extension
*.so
*.o
*.a

# ---------------------------------------------------------------------------
# Tool caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Stray artefacts at the repo root.
# Deliberately root-anchored: an unanchored `*.txt` / `*.csv` silently hides
# legitimate nested files (a requirements file, a test fixture).
# ---------------------------------------------------------------------------
/*.txt
/*.csv
/*.log
/*.pkl
/*.pklz

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.cursorignore
pyrightconfig.json

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Leftover upstream paths, kept only so that restoring an old tree does not
# re-add junk. Nothing here exists in the consolidated layout.
# ---------------------------------------------------------------------------
tmp
pretrained_models
